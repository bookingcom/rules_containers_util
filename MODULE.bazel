module(
    name = "rules_containers_util",
    version = "0.0.1",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "platforms_contrib", version = "1.0.0-alpha.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_img", version = "0.3.24-20261029-189a6a2")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "tar.bzl", version = "0.10.9")

bsd_tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(bsd_tar_toolchains, "bsd_tar_toolchains")

register_toolchains("@bsd_tar_toolchains//:all")

containers = use_extension(
    "//containers:extensions.bzl",
    "containers",
)
containers.toolchains(from_source = True)
use_repo(containers, "dockerfile_parser_toolchains")

register_toolchains("@dockerfile_parser_toolchains//:all")

bazel_dep(name = "rules_go", version = "0.65.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.12.0", dev_dependency = True)
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.10", dev_dependency = True)

python = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters", dev_dependency = True)
python.toolchain(python_version = "3.13")
use_repo(
    python,
    "python_3_13_aarch64_apple_darwin",
    "python_3_13_aarch64_unknown_linux_gnu",
    "python_3_13_x86_64_apple_darwin",
    "python_3_13_x86_64_unknown_linux_gnu",
    "python_interpreters",
)

register_toolchains(
    "@python_interpreters//:all",
    dev_dependency = True,
)

bazel_dep(name = "dnf5-prebuilt", version = "5.4.6.0.bcr.3", dev_dependency = True)
archive_override(
    module_name = "dnf5-prebuilt",
    integrity = "sha256-Lsvj4dkCXXnGO7+cX4ZNAAmkrN6fLgHkYn1R0jkt1zc=",
    strip_prefix = "dnf5-prebuilt-5.4.6.0.bcr.3",
    urls = ["https://github.com/bookingcom/dnf5-prebuilt/releases/download/v5.4.6.0.bcr.3/dnf5-prebuilt-v5.4.6.0.bcr.3.tar.gz"],
)

dnf5 = use_extension("@dnf5-prebuilt//dnf5-prebuilt:extensions.bzl", "dnf5", dev_dependency = True)
dnf5.toolchains()
use_repo(dnf5, "dnf5_toolchains")

register_toolchains(
    "@dnf5_toolchains//:all",
    dev_dependency = True,
)

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "oraclelinux_10_slim",
    layer_handling = "eager",
    platforms = ["linux/amd64"],
    registry = "index.docker.io",
    repository = "library/oraclelinux",
    tag = "10-slim",
    unsafe_allow_tag_without_digest = True,
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.from_file(go_mod = "//:go.mod")
use_repo(go_sdk, "go_toolchains")

register_toolchains("@go_toolchains//:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "cc_mvdan_sh_v3",
    "com_github_moby_buildkit",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "latest",
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")
