"""Remote execution container image, overridable with --repo_env."""

_BUILD = """\
# Generated by //bazel:rbe.bzl.
platform(
    name = "platform",
    exec_properties = {exec_properties},
    parents = ["@buildbuddy_toolchain//:platform_linux_x86_64"],
    visibility = ["//visibility:public"],
)
"""

def _rbe_container_image_impl(rctx):
    image = rctx.getenv("RBE_CONTAINER_IMAGE", "")
    exec_properties = {"container-image": image} if image else {}
    rctx.file("BUILD.bazel", _BUILD.format(exec_properties = repr(exec_properties)))

rbe_container_image = repository_rule(
    implementation = _rbe_container_image_impl,
    doc = """Platform that sets the container image of remote actions.

It inherits from the toolchains_buildbuddy platform (whose image is configured
in MODULE.bazel) and, when the RBE_CONTAINER_IMAGE repository environment
variable is set, overrides `container-image` with its value, e.g.:

    common --repo_env=RBE_CONTAINER_IMAGE=docker://registry.example.com/rbe@sha256:<digest>
""",
    environ = ["RBE_CONTAINER_IMAGE"],
)
